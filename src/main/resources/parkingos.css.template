/* Phase 4: motion language — one easing family, reduce-motion honored. */
.motion-fast { -fx-animation-duration: 150ms; }
.motion-normal { -fx-animation-duration: 250ms; }
.motion-slow { -fx-animation-duration: 350ms; }

.reduce-motion * {
    -fx-animation-duration: 1ms;
}

.skeleton-sheen {
    -fx-opacity: 0.55;
}

.reduce-motion .skeleton-sheen {
    -fx-opacity: 0;
}

.toast-icon-success,
.toast-icon-error,
