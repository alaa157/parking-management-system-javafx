.app-root {
    /* JavaFX has no browser-style CSS custom properties; these semantic classes
       are the stylesheet counterpart to DesignTokens.java. */
    -fx-background-color: @BG@;
    -fx-font-family: "Segoe UI", "Arial";
    -fx-color-scheme: dark;
}
.theme-text { -fx-text-fill: @TEXT@; }
.theme-muted { -fx-text-fill: @MUTED@; }

/* Shared type scale. Views use semantic classes through DesignTokens.text(). */
.type-display { -fx-font-size: 30px; -fx-line-spacing: 4.5; }
.type-h1 { -fx-font-size: 24px; -fx-line-spacing: 3.6; }
.type-h2 { -fx-font-size: 18px; -fx-line-spacing: 2.7; }
.type-body { -fx-font-size: 14px; -fx-line-spacing: 2.1; }
.type-caption { -fx-font-size: 12px; -fx-line-spacing: 2.4; }
.type-micro { -fx-font-size: 10px; -fx-line-spacing: 2.0; }

/* Phase 2: vertical-rhythm helpers — headings sit tighter, body copy breathes. */
.type-tight { -fx-line-spacing: -1; }
.type-loose { -fx-line-spacing: 4; }

/* Phase 2: spacing utilities — snap padding to the 4px scale from DesignTokens. */
.pad-1 { -fx-padding: 4px; }
.pad-2 { -fx-padding: 8px; }
.pad-3 { -fx-padding: 12px; }
.pad-4 { -fx-padding: 16px; }
.pad-5 { -fx-padding: 20px; }
.pad-6 { -fx-padding: 24px; }
.pad-8 { -fx-padding: 32px; }
.pad-10 { -fx-padding: 40px; }

/* Phase 2: shape utilities — single source for corner radii. */
.radius-sm { -fx-background-radius: 8px; -fx-border-radius: 8px; }
.radius-md { -fx-background-radius: 12px; -fx-border-radius: 12px; }
.radius-lg { -fx-background-radius: 16px; -fx-border-radius: 16px; }
.radius-xl { -fx-background-radius: 24px; -fx-border-radius: 24px; }
.radius-pill { -fx-background-radius: 999px; -fx-border-radius: 999px; }

.skeleton-overlay {
    -fx-background-color: @OVERLAY_DARK@;
    -fx-background-radius: 12px;
    -fx-padding: 12px;
}
.skeleton-block {
    -fx-background-color: @SKELETON_BLOCK@;
    -fx-background-radius: 7px;
}
.skeleton-card {
    -fx-background-color: @CARD@;
    -fx-background-radius: 12px;
    -fx-border-color: @BORDER@;
    -fx-border-radius: 12px;
}
.empty-state { -fx-padding: 34px; }
.empty-state .label { -fx-text-alignment: center; }
.modal-layer { -fx-background-color: transparent; }
.modal-card {
    -fx-background-color: @CARD@;
    -fx-background-radius: 16px;
    -fx-border-color: @BORDER@;
    -fx-border-radius: 16px;
    -fx-padding: 24px;
    -fx-effect: dropshadow(gaussian, @SHADOW_BLACK_55@, 30, .18, 0, 10);
}
.command-palette {
    -fx-background-color: @CARD@;
    -fx-background-radius: 14px;
    -fx-border-color: @BORDER@;
    -fx-border-radius: 14px;
}
.command-results { -fx-background-color: @SURFACE_HEADER@; -fx-background-radius: 8px; }
.command-results .list-cell { -fx-background-color: transparent; -fx-text-fill: @TEXT@; }
.command-results .list-cell:filled:hover,
.command-results .list-cell:filled:selected { -fx-background-color: @HOVER@; }
.hamburger-button {
    -fx-background-color: @CARD@;
    -fx-background-radius: 8px;
    -fx-border-color: @BORDER@;
    -fx-border-radius: 8px;
    -fx-padding: 9px;
}
.sidebar-collapse {
    -fx-background-color: transparent;
    -fx-padding: 6px;
    -fx-cursor: hand;
}
.field-invalid {
    -fx-border-color: @RED@ !important;
    -fx-border-width: 2px !important;
    -fx-background-color: @GLOW_RED_16@ !important;
}
.field-valid {
    -fx-border-color: @GREEN@ !important;
    -fx-border-width: 2px !important;
}
.validation-error { -fx-text-fill: @RED@; -fx-font-size: 11px; -fx-font-weight: 600; }
.validation-success { -fx-text-fill: @GREEN@; -fx-font-size: 11px; -fx-font-weight: 600; }

/* Phase 3: inputs — visible 44px hit area, prompt contrast, combo parity. */
.dark-input, .toolbar-input {
    -fx-pref-height: 44px;
    -fx-min-height: 44px;
}

.dark-input:hover, .toolbar-input:hover {
    -fx-border-color: @MUTED@;
}

.dark-input:disabled, .toolbar-input:disabled {
    -fx-opacity: 0.55;
}

.dark-combo:hover {
    -fx-border-color: @TEAL@;
}

.dark-combo:focused {
    -fx-border-color: @TEAL@;
    -fx-border-width: 2px;
}

.dark-combo:disabled {
    -fx-opacity: 0.55;
}

.dark-combo .list-cell:filled:hover,
.dark-combo .list-cell:filled:selected {
    -fx-background-color: @HOVER@;
    -fx-text-fill: @TEAL@;
}

/* Layer scale. JavaFX viewOrder is applied by StyleManager as the runtime
   fallback for this semantic z-index contract. */
.z-0 { -fx-z-index: 0; }
.z-1 { -fx-z-index: 1; }
.z-2 { -fx-z-index: 2; }
.z-5 { -fx-z-index: 5; }
.z-10 { -fx-z-index: 10; }
.z-20 { -fx-z-index: 20; }
.z-30 { -fx-z-index: 30; }

.skip-link {
    -fx-background-color: @TEAL@;
    -fx-text-fill: @BG@;
    -fx-font-weight: 700;
    -fx-padding: 6px 10px;
    -fx-background-radius: 6px;
    -fx-translate-y: -40px;
}
.skip-link:focused { -fx-translate-y: 0; }
.high-contrast { -fx-color-scheme: light dark; }
.high-contrast .focus-visible,.high-contrast .button:focused,.high-contrast .text-field:focused,.high-contrast .combo-box:focused,.high-contrast .toggle-button:focused,.high-contrast .table-row-cell:focused {    -fx-border-color: @LIGHT_CARD@;    -fx-border-width: 4px;}.theme-light.app-root,
